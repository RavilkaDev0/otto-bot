# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=otto_bot
DB_USER=otto_user
DB_PASS=your_db_password

# Redis
REDIS_URL=redis://redis:6379/0

# ARQ Background Worker
ARQ_REDIS_URL=redis://redis:6379/0
ARQ_QUEUE_NAME=arq:otto-bot
ARQ_WORKER_CONCURRENCY=10
OPENAI_ATTRIBUTE_FILL_API_KEYS=

# Frontend
FRONTEND_APP_URL=http://localhost:3000
UPLOADS_DIR=/app/uploads

# Sentry Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=otto-bot@latest
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=otto-bot-frontend
SENTRY_FRONTEND_PROJECT=otto-bot-frontend

# RabbitMQ
RABBITMQ_DEFAULT_USER=altera
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password
RABBITMQ_APP_USER=fastapi_user
RABBITMQ_APP_PASSWORD=your_app_password
